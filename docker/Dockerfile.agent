# Adds real developer tooling (Node/npm, Python venv/pip) and Claude Code on top of versionfs-dev,
# and runs as an unprivileged user, the way VersionFS is used in practice.
#   docker build -t versionfs-dev docker/
#   docker build -t versionfs-agent -f docker/Dockerfile.agent docker/
FROM versionfs-dev
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      nodejs npm python3-venv python3-pip curl \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g @anthropic-ai/claude-code
RUN useradd -m dev
USER dev
WORKDIR /home/dev
